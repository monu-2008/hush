{
  "manifest_version": 3,
  "name": "Hush — Private Messages",
  "version": "1.0.0",
  "description": "Encrypt a private note from any page and carry it as an emoji, image, QR, or audio. By AQERIONX.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "host_permissions": [],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
